{
  "name": "ghostty-atlas",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "description": "Ghostty theme catalog, comparison, and lossless config editor with React and Base UI",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "pnpm themes:refresh && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test",
    "benchmark:catalog": "node scripts/benchmark-theme-strip.js",
    "format": "oxfmt --write 'src/**/*' 'scripts/**/*' 'tests/**/*' '.github/**/*' '*.js' package.json '.ox*rc.json' '*.md'",
    "format:check": "oxfmt --check 'src/**/*' 'scripts/**/*' 'tests/**/*' '.github/**/*' '*.js' package.json '.ox*rc.json' '*.md'",
    "themes:refresh": "node scripts/refresh-themes.js",
    "hooks:install": "node scripts/install-hooks.js",
    "prepare": "pnpm hooks:install",
    "lint": "oxlint .",
    "check": "pnpm themes:refresh && pnpm lint && pnpm test && vite build && pnpm format:check",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
